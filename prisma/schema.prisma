generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  HACKER
  ORGANIZER
  DIRECTOR
  ADMIN
}

enum Gender {
  WOMAN
  MAN
  NON_BINARY
  PREFER_NOT_TO_SAY
}

enum TransportMode {
  BUS
  TRAIN
  AIRPLANE
}

enum TravelReimbursementStatus {
  DRAFT
  PENDING_REVIEW
  CHANGES_REQUESTED
  REJECTED
  APPROVED
  FINAL_REVIEW
  FINAL_APPROVED
}

model User {
  id                      String                   @id @default(cuid())
  name                    String?
  email                   String                   @unique
  emailVerified           DateTime?
  image                   String?
  passwordHash            String?
  role                    Role                     @default(HACKER)
  gender                  Gender?
  city                    String?
  major                   String?
  accounts                Account[]
  sessions                Session[]
  expenses                Expense[]
  travelReimbursement     TravelReimbursement?     @relation("TravelHacker")
  initialTravelReviews    TravelReimbursement[]    @relation("InitialTravelReviewer")
  finalTravelReviews      TravelReimbursement[]    @relation("FinalTravelReviewer")
  travelStatusEvents      TravelStatusEvent[]      @relation("TravelStatusActor")
  travelRequirementChecks TravelRequirementCheck[] @relation("TravelRequirementChecker")
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Expense {
  id            String       @id @default(cuid())
  description   String
  categoryLabel String       @map("category")
  amountCents   Int
  incurredAt    DateTime
  vendor        String?
  ticketPath    String?
  organizerId   String
  organizer     User         @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategoryId String?
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  departmentId  String?
  department    Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())

  @@index([organizerId, incurredAt])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([departmentId])
}

model Category {
  id            String        @id @default(cuid())
  name          String        @unique
  budgetCents   Int           @default(0)
  active        Boolean       @default(true)
  subcategories Subcategory[]
  expenses      Expense[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Subcategory {
  id          String    @id @default(cuid())
  name        String
  budgetCents Int       @default(0)
  active      Boolean   @default(true)
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  expenses    Expense[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([categoryId, name])
}

model Department {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  active    Boolean   @default(true)
  expenses  Expense[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model TravelReimbursement {
  id                     String                    @id @default(cuid())
  hackerId               String                    @unique
  hacker                 User                      @relation("TravelHacker", fields: [hackerId], references: [id], onDelete: Cascade)
  status                 TravelReimbursementStatus @default(DRAFT)
  originCity             String
  originCountry          String
  transportMode          TransportMode
  outboundDepartureAt    DateTime
  outboundDeparturePlace String
  outboundArrivalAt      DateTime
  outboundArrivalPlace   String
  outboundCarrier        String
  outboundServiceNumber  String?
  returnDepartureAt      DateTime
  returnDeparturePlace   String
  returnArrivalAt        DateTime
  returnArrivalPlace     String
  returnCarrier          String
  returnServiceNumber    String?
  totalPriceCents        Int
  luggagePaid            Boolean                   @default(false)
  luggagePriceCents      Int?
  ticketPath             String
  organizerNote          String?
  approvedAmountCents    Int?
  submittedAt            DateTime?
  initialReviewedAt      DateTime?
  initialReviewerId      String?
  initialReviewer        User?                     @relation("InitialTravelReviewer", fields: [initialReviewerId], references: [id], onDelete: SetNull)
  approvedAt             DateTime?
  demoUrl                String?
  demoComment            String?
  demoSubmittedAt        DateTime?
  finalReviewerId        String?
  finalReviewer          User?                     @relation("FinalTravelReviewer", fields: [finalReviewerId], references: [id], onDelete: SetNull)
  finalApprovedAt        DateTime?
  statusEvents           TravelStatusEvent[]
  requirementChecks      TravelRequirementCheck[]
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  @@index([status, submittedAt])
  @@index([initialReviewerId])
  @@index([finalReviewerId])
}

model TravelStatusEvent {
  id              String                     @id @default(cuid())
  reimbursementId String
  reimbursement   TravelReimbursement        @relation(fields: [reimbursementId], references: [id], onDelete: Cascade)
  fromStatus      TravelReimbursementStatus?
  toStatus        TravelReimbursementStatus
  note            String?
  actorId         String?
  actor           User?                      @relation("TravelStatusActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt       DateTime                   @default(now())

  @@index([reimbursementId, createdAt])
  @@index([actorId])
}

model TravelEventSettings {
  id                        String    @id @default("event")
  hackathonStartAt          DateTime?
  reimbursementInstructions String    @default("Lorem ipsum dolor sit amet, consectetur adipiscing elit.")
  finalReviewInstructions   String    @default("Lorem ipsum dolor sit amet, consectetur adipiscing elit.")
  updatedAt                 DateTime  @updatedAt
}

model TravelFinalRequirement {
  id        String                   @id @default(cuid())
  name      String                   @unique
  active    Boolean                  @default(true)
  checks    TravelRequirementCheck[]
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt
}

model TravelRequirementCheck {
  reimbursementId String
  requirementId   String
  checked         Boolean                @default(false)
  checkedAt       DateTime?
  checkedById     String?
  reimbursement   TravelReimbursement    @relation(fields: [reimbursementId], references: [id], onDelete: Cascade)
  requirement     TravelFinalRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  checkedBy       User?                  @relation("TravelRequirementChecker", fields: [checkedById], references: [id], onDelete: SetNull)

  @@id([reimbursementId, requirementId])
  @@index([requirementId])
  @@index([checkedById])
}
