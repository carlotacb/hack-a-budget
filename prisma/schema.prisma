generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  HACKER
  ORGANIZER
  ORGANIZER_LEAD
  DIRECTOR
  ADMIN
}

enum Gender {
  WOMAN
  MAN
  NON_BINARY
  PREFER_NOT_TO_SAY
}

enum Diet {
  OMNIVORE
  VEGETARIAN
  VEGAN
  GLUTEN_FREE
  HALAL
  KOSHER
  OTHER
}

enum TShirtSize {
  XS
  S
  M
  L
  XL
  XXL
}

enum TransportMode {
  BUS
  TRAIN
  AIRPLANE
}

enum TravelReimbursementStatus {
  DRAFT
  PENDING_REVIEW
  CHANGES_REQUESTED
  REJECTED
  APPROVED
  FINAL_REVIEW
  FINAL_APPROVED
}

model User {
  id                      String                   @id @default(cuid())
  name                    String?
  email                   String                   @unique
  emailVerified           DateTime?
  image                   String?
  passwordHash            String?
  gender                  Gender?
  diet                    Diet?
  tshirtSize              TShirtSize?
  accounts                Account[]
  sessions                Session[]
  memberships             HackathonMembership[]
  expenses                Expense[]
  travelReimbursements    TravelReimbursement[]    @relation("TravelHacker")
  initialTravelReviews    TravelReimbursement[]    @relation("InitialTravelReviewer")
  finalTravelReviews      TravelReimbursement[]    @relation("FinalTravelReviewer")
  travelStatusEvents      TravelStatusEvent[]      @relation("TravelStatusActor")
  travelRequirementChecks TravelRequirementCheck[] @relation("TravelRequirementChecker")
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
}

/**
 * A user's role within a single hackathon. A user may belong to several
 * hackathons (e.g. as HACKER in one and ADMIN in another), so the role
 * lives here rather than on User.
 */
model HackathonMembership {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  hackathonId  String
  hackathon    Hackathon   @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  role         Role        @default(HACKER)
  // Only meaningful for roles configured to relate to a department (e.g.
  // Organizer / Organizer Lead when the hackathon's role settings turn
  // that on). Cleared automatically if the role changes or the
  // department is deleted.
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())

  @@unique([userId, hackathonId])
  @@index([hackathonId])
  @@index([departmentId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Expense {
  id            String       @id @default(cuid())
  description   String
  categoryLabel String       @map("category")
  amountCents   Int
  incurredAt    DateTime
  vendor        String?
  ticketPath    String?
  organizerId   String
  organizer     User         @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  hackathonId   String
  hackathon     Hackathon    @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategoryId String?
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  departmentId  String?
  department    Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  // Which budget plan this expense is attributed to — defaults to whichever
  // budget was active at creation time, but can be changed (e.g. to log an
  // expense against a past budget) so dashboards can report per-budget.
  budgetId      String?
  budget        Budget?      @relation(fields: [budgetId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())

  @@index([organizerId, incurredAt])
  @@index([hackathonId])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([departmentId])
  @@index([budgetId])
}

model Category {
  id               String           @id @default(cuid())
  name             String
  hackathonId      String
  hackathon        Hackathon        @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  // The department a category's expenses are attributed to. All of a
  // category's subcategories share this department — set once here rather
  // than per subcategory, so department-scoped visibility only needs to
  // check the category.
  departmentId     String
  department       Department       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  budgetCents      Int              @default(0)
  active           Boolean          @default(true)
  subcategories    Subcategory[]
  expenses         Expense[]
  budgetCategories BudgetCategory[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([hackathonId, name])
  @@index([departmentId])
}

model Subcategory {
  id                  String              @id @default(cuid())
  name                String
  budgetCents         Int                 @default(0)
  active              Boolean             @default(true)
  categoryId          String
  category            Category            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  expenses            Expense[]
  budgetSubcategories BudgetSubcategory[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([categoryId, name])
}

model Budget {
  id          String           @id @default(cuid())
  name        String
  isActive    Boolean          @default(false)
  hackathonId String
  hackathon   Hackathon        @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  basedOnId   String?
  basedOn     Budget?          @relation("BudgetRevision", fields: [basedOnId], references: [id], onDelete: SetNull)
  revisions   Budget[]         @relation("BudgetRevision")
  categories  BudgetCategory[]
  expenses    Expense[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([basedOnId])
  @@index([hackathonId])
}

model BudgetCategory {
  id            String              @id @default(cuid())
  budgetId      String
  budget        Budget              @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name          String
  budgetCents   Int                 @default(0)
  isUnexpected  Boolean             @default(false)
  subcategories BudgetSubcategory[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([budgetId])
  @@index([categoryId])
}

model BudgetSubcategory {
  id               String         @id @default(cuid())
  budgetCategoryId String
  budgetCategory   BudgetCategory @relation(fields: [budgetCategoryId], references: [id], onDelete: Cascade)
  subcategoryId    String?
  subcategory      Subcategory?   @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  name             String
  budgetCents      Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([budgetCategoryId])
  @@index([subcategoryId])
}

model Department {
  id            String                 @id @default(cuid())
  code          String
  name          String
  active        Boolean                @default(true)
  // Hex color (e.g. "#8b5cf6") shown on department tags across the app
  // (budget categories, expense lists, etc.) so departments are visually
  // distinguishable at a glance. Configurable per department in Settings.
  color         String                 @default("#64748b")
  hackathonId   String
  hackathon     Hackathon              @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  expenses      Expense[]
  categories    Category[]
  memberships   HackathonMembership[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@unique([hackathonId, code])
}

model TravelReimbursement {
  id                     String                    @id @default(cuid())
  hackerId               String
  hacker                 User                      @relation("TravelHacker", fields: [hackerId], references: [id], onDelete: Cascade)
  hackathonId            String
  hackathon              Hackathon                 @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  status                 TravelReimbursementStatus @default(DRAFT)
  originCity             String
  originCountry          String
  transportMode          TransportMode
  outboundDepartureAt    DateTime
  outboundDeparturePlace String
  outboundArrivalAt      DateTime
  outboundArrivalPlace   String
  outboundCarrier        String
  outboundServiceNumber  String?
  returnDepartureAt      DateTime
  returnDeparturePlace   String
  returnArrivalAt        DateTime
  returnArrivalPlace     String
  returnCarrier          String
  returnServiceNumber    String?
  totalPriceCents        Int
  totalCurrencyCode      String                    @default("EUR")
  luggagePaid            Boolean                   @default(false)
  luggagePriceCents      Int?
  ticketPath             String
  organizerNote          String?
  approvedAmountCents    Int?
  submittedAt            DateTime?
  initialReviewedAt      DateTime?
  initialReviewerId      String?
  initialReviewer        User?                     @relation("InitialTravelReviewer", fields: [initialReviewerId], references: [id], onDelete: SetNull)
  approvedAt             DateTime?
  demoUrl                String?
  demoComment            String?
  demoSubmittedAt        DateTime?
  finalReviewerId        String?
  finalReviewer          User?                     @relation("FinalTravelReviewer", fields: [finalReviewerId], references: [id], onDelete: SetNull)
  finalApprovedAt        DateTime?
  statusEvents           TravelStatusEvent[]
  requirementChecks      TravelRequirementCheck[]
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  @@unique([hackathonId, hackerId])
  @@index([status, submittedAt])
  @@index([initialReviewerId])
  @@index([finalReviewerId])
}

model TravelStatusEvent {
  id              String                     @id @default(cuid())
  reimbursementId String
  reimbursement   TravelReimbursement        @relation(fields: [reimbursementId], references: [id], onDelete: Cascade)
  fromStatus      TravelReimbursementStatus?
  toStatus        TravelReimbursementStatus
  note            String?
  actorId         String?
  actor           User?                      @relation("TravelStatusActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt       DateTime                   @default(now())

  @@index([reimbursementId, createdAt])
  @@index([actorId])
}

model Hackathon {
  id                         String                   @id @default(cuid())
  name                       String
  travelReimbursementEnabled Boolean                  @default(true)
  // Escape hatch for future per-event personalization fields (e.g. theme,
  // custom links) that don't warrant a migration yet. Promote a field to a
  // real column once its shape stabilizes.
  settings                   Json                     @default("{}")
  memberships                HackathonMembership[]
  departments                Department[]
  categories                 Category[]
  budgets                    Budget[]
  expenses                   Expense[]
  travelReimbursements       TravelReimbursement[]
  travelEventSettings        TravelEventSettings?
  travelMessageTemplates     TravelMessageTemplate[]
  travelFinalRequirements    TravelFinalRequirement[]
  hackerInvites              HackerInvite[]
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
}

model HackerInvite {
  id          String    @id @default(cuid())
  token       String    @unique
  hackathonId String
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  createdById String
  usedAt      DateTime?
  usedById    String?
  createdAt   DateTime  @default(now())

  @@index([createdById])
  @@index([hackathonId])
}

model TravelEventSettings {
  id                        String    @id @default(cuid())
  hackathonId               String    @unique
  hackathon                 Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  hackathonStartAt          DateTime?
  reimbursementInstructions String    @default("Lorem ipsum dolor sit amet, consectetur adipiscing elit.")
  finalReviewInstructions   String    @default("Lorem ipsum dolor sit amet, consectetur adipiscing elit.")
  updatedAt                 DateTime  @updatedAt
}

model TravelMessageTemplate {
  id          String    @id @default(cuid())
  name        String
  hackathonId String
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  message     String
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([hackathonId, name])
  @@index([active])
}

model TravelFinalRequirement {
  id          String                   @id @default(cuid())
  name        String
  hackathonId String
  hackathon   Hackathon                @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  active      Boolean                  @default(true)
  checks      TravelRequirementCheck[]
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@unique([hackathonId, name])
}

model TravelRequirementCheck {
  reimbursementId String
  requirementId   String
  checked         Boolean                @default(false)
  checkedAt       DateTime?
  checkedById     String?
  reimbursement   TravelReimbursement    @relation(fields: [reimbursementId], references: [id], onDelete: Cascade)
  requirement     TravelFinalRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  checkedBy       User?                  @relation("TravelRequirementChecker", fields: [checkedById], references: [id], onDelete: SetNull)

  @@id([reimbursementId, requirementId])
  @@index([requirementId])
  @@index([checkedById])
}
