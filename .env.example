DATABASE_URL="file:./dev.db"
# Required in production. Uncomment and replace with `openssl rand -base64 32`.
# `npm run dev` generates a separate ignored AUTH_SECRET_DEV automatically.
# AUTH_SECRET="replace-with-a-secure-random-value"

# Optional: enabling these values adds Google to the login screen.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
