# Neon Postgres. DATABASE_URL should be the pooled connection string
# (the one with "-pooler" in the host); DIRECT_URL is the direct connection,
# used only for running migrations (`prisma migrate deploy`/`dev`).
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/dbname?sslmode=require"

# Required in production. Uncomment and replace with `openssl rand -base64 32`.
# `npm run dev` generates a separate ignored AUTH_SECRET_DEV automatically.
# AUTH_SECRET="replace-with-a-secure-random-value"

# Required for ticket uploads (expenses and travel reimbursements) once
# deployed, since the filesystem isn't writable/persistent on Vercel.
# Create a Blob store in the Vercel dashboard (Storage tab) to get this.
BLOB_READ_WRITE_TOKEN=""

# Optional: enabling these values adds Google to the login screen.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
